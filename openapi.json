{
  "openapi": "3.0.3",
  "info": {
    "title": "Daily Ops Last Mile Dashboard",
    "version": "2.0.0",
    "description": "Live nationwide operations dashboard for Ninja Van's last-mile fleet (143 stations across Southern, Northern, Klang Valley, East Coast, and East Malaysia). Pulls parcel-level and route-level data hourly from Redash (queries 78, 1297, 653, 512) and serves in-hub/zero-attempt/on-hold/pending-ATS/aging/prior-tag/COD% counts plus Missing Hub-vs-Ship-in and Total Routed/Attendance, by station/zone/region, scoped to the signed-in user's role. Every count has a click-to-see-tracking-numbers drill-down except route-level totals and percentages."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check used by the platform to confirm the backend container is up.",
        "responses": {
          "200": {
            "description": "Backend is up",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Return the signed-in user's identity and role/scope, derived from the SSO-injected X-Forwarded-Email header.",
        "responses": {
          "200": {
            "description": "Current user identity (unauthenticated or unprovisioned users get null/false fields)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Me"}}}
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "summary": "Return the latest station metrics snapshot, filtered to the caller's role scope, with zone and region rollups.",
        "responses": {
          "200": {
            "description": "Latest snapshot, scoped to the caller",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DashboardResponse"}}}
          }
        }
      }
    },
    "/api/stations": {
      "get": {
        "summary": "List all active/virtual stations nationwide (hub code, name, zone, region) from the station reference data.",
        "responses": {
          "200": {
            "description": "All active/virtual stations",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/StationMeta"}}}}
          }
        }
      }
    },
    "/api/regions": {
      "get": {
        "summary": "List all regions and the zones within each, for building region/zone pickers in the UI.",
        "responses": {
          "200": {
            "description": "All regions with their zones",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/RegionMeta"}}}}
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "summary": "List all users provisioned for the dashboard, with their role and scope. Admin only.",
        "responses": {
          "200": {
            "description": "All provisioned users",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/UserOut"}}}}
          },
          "403": {"description": "Caller is not an admin"}
        }
      },
      "post": {
        "summary": "Provision a new user with a role and access scope (all / region / zone / station). Admin only.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserIn"}}}
        },
        "responses": {
          "200": {
            "description": "User created",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OkResult"}}}
          },
          "403": {"description": "Caller is not an admin"},
          "409": {"description": "That email is already set up"},
          "422": {"description": "Invalid role or scope value"}
        }
      }
    },
    "/api/admin/users/{email}": {
      "patch": {
        "summary": "Update an existing user's role, scope, or display name. Admin only.",
        "parameters": [
          {"name": "email", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserIn"}}}
        },
        "responses": {
          "200": {
            "description": "User updated",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OkResult"}}}
          },
          "403": {"description": "Caller is not an admin"},
          "422": {"description": "Invalid role or scope value"}
        }
      },
      "delete": {
        "summary": "Remove a user's access to the dashboard. Admin only; an admin cannot remove their own access.",
        "parameters": [
          {"name": "email", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "User removed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OkResult"}}}
          },
          "400": {"description": "Cannot remove your own access"},
          "403": {"description": "Caller is not an admin"}
        }
      }
    },
    "/api/drilldown": {
      "get": {
        "summary": "Return the tracking numbers behind one station's metric count, for the UI's click-a-number drill-down. Served from an in-memory cache built by the last refresh.",
        "parameters": [
          {"name": "station_code", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "metric", "in": "query", "required": true, "schema": {"type": "string", "description": "One of the drilldown-eligible metric keys (all StationRow metrics except total_fresh)"}}
        ],
        "responses": {
          "200": {
            "description": "Tracking numbers for that station/metric",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DrilldownResponse"}}}
          },
          "403": {"description": "That station isn't in the caller's scope"},
          "404": {"description": "Unknown station"},
          "422": {"description": "metric is not a drilldown-eligible key"}
        }
      }
    },
    "/api/admin/refresh": {
      "post": {
        "summary": "Trigger an immediate Redash pull and metrics recompute, instead of waiting for the hourly scheduler. Admin only.",
        "responses": {
          "200": {
            "description": "Result of the refresh that just ran",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshStatus"}}}
          },
          "403": {"description": "Caller is not an admin"}
        }
      }
    },
    "/api/admin/refresh-status": {
      "get": {
        "summary": "Return the status of the most recent refresh (scheduled or manual). Admin only.",
        "responses": {
          "200": {
            "description": "Most recent refresh-log entry, or null if none have run yet",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshStatus"}}}
          },
          "403": {"description": "Caller is not an admin"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {"status": {"type": "string"}},
        "required": ["status"]
      },
      "Me": {
        "type": "object",
        "properties": {
          "email": {"type": "string", "nullable": true},
          "provisioned": {"type": "boolean"},
          "role": {"type": "string", "nullable": true, "description": "admin | manager | station"},
          "scope_type": {"type": "string", "nullable": true, "description": "all | region | zone | station"},
          "scope_value": {"type": "string", "nullable": true},
          "display_name": {"type": "string", "nullable": true}
        },
        "required": ["email", "provisioned"]
      },
      "MetricFields": {
        "type": "object",
        "description": "All fields are grouped by last_scan_hub_name (where a parcel physically is right now) unless noted otherwise -- see backend/aggregate.py for the full formulas.",
        "properties": {
          "total_in_hub": {"type": "integer", "description": "last_scan_hub_name == dest_hub, excludes On Hold/On Vehicle for Delivery"},
          "zero_attempt": {"type": "integer", "description": "Subset of total_in_hub with 0 delivery attempts"},
          "zero_attempt_gt_d0": {"type": "integer", "description": "Subset of zero_attempt aged >0 days"},
          "on_hold": {"type": "integer"},
          "pending_ats": {"type": "integer", "description": "last_scan_hub_name != dest_hub -- not yet added to a shipment to its real destination"},
          "missing_open": {"type": "integer", "description": "Open missing-parcel tickets, total (grouped by dest_hub_name)"},
          "missing_hub": {"type": "integer", "description": "Subset of missing_open classified as a station-side issue"},
          "missing_ship_in": {"type": "integer", "description": "Subset of missing_open classified as an in-transit issue"},
          "total_fresh": {"type": "integer", "description": "Total orders received today per hub (query 653, grouped by dest_hub_name)"},
          "age_gt3": {"type": "integer", "description": "total_in_hub aged >3 days, excludes On Hold/On Vehicle for Delivery"},
          "age_gt6_ats": {"type": "integer", "description": "Subset of pending_ats aged >6 days"},
          "reschedule": {"type": "integer", "description": "total_in_hub with 1+ delivery attempts already made"},
          "still_ovfd": {"type": "integer", "description": "Still On Vehicle for Delivery"},
          "prior_d0": {"type": "integer", "description": "total_in_hub, status Arrived at Sorting Hub, PRIOR tag, 0 attempts"},
          "prior_gt_d0": {"type": "integer", "description": "total_in_hub, status Arrived at Sorting Hub, PRIOR tag, aged >0 days"},
          "cod_pct_hub": {"type": "number", "description": "% of total_in_hub that is COD"},
          "total_routed": {"type": "integer", "description": "From query 512, matched by full station name"},
          "attendance": {"type": "integer", "description": "Unique drivers with a route today, from query 512, excluding names containing OPS"},
          "cod_pct_routed": {"type": "number", "description": "% of total_routed that is COD, from query 512"}
        },
        "required": ["total_in_hub", "zero_attempt", "zero_attempt_gt_d0", "on_hold", "pending_ats", "missing_open", "missing_hub", "missing_ship_in", "total_fresh", "age_gt3", "age_gt6_ats", "reschedule", "still_ovfd", "prior_d0", "prior_gt_d0", "cod_pct_hub", "total_routed", "attendance", "cod_pct_routed"]
      },
      "StationRow": {
        "allOf": [
          {"$ref": "#/components/schemas/MetricFields"},
          {
            "type": "object",
            "properties": {
              "station_code": {"type": "string"},
              "station_name": {"type": "string"},
              "zone": {"type": "string"},
              "region": {"type": "string"}
            },
            "required": ["station_code", "station_name", "zone", "region"]
          }
        ]
      },
      "GroupRow": {
        "allOf": [
          {"$ref": "#/components/schemas/MetricFields"},
          {
            "type": "object",
            "properties": {
              "key": {"type": "string", "description": "The zone or region name this row rolls up"},
              "station_count": {"type": "integer"}
            },
            "required": ["key", "station_count"]
          }
        ]
      },
      "DashboardResponse": {
        "type": "object",
        "properties": {
          "captured_at": {"type": "string", "nullable": true, "format": "date-time"},
          "stations": {"type": "array", "items": {"$ref": "#/components/schemas/StationRow"}},
          "zones": {"type": "array", "items": {"$ref": "#/components/schemas/GroupRow"}},
          "regions": {"type": "array", "items": {"$ref": "#/components/schemas/GroupRow"}},
          "previous_captured_at": {"type": "string", "nullable": true, "format": "date-time", "description": "Timestamp of the second-most-recent snapshot, for trend deltas"},
          "previous_stations": {"type": "array", "items": {"$ref": "#/components/schemas/StationRow"}}
        },
        "required": ["captured_at", "stations", "zones", "regions"]
      },
      "UserOut": {
        "type": "object",
        "properties": {
          "email": {"type": "string"},
          "role": {"type": "string"},
          "scope_type": {"type": "string"},
          "scope_value": {"type": "string", "nullable": true},
          "display_name": {"type": "string", "nullable": true},
          "created_at": {"type": "string"}
        },
        "required": ["email", "role", "scope_type", "scope_value", "display_name", "created_at"]
      },
      "UserIn": {
        "type": "object",
        "properties": {
          "email": {"type": "string"},
          "role": {"type": "string", "description": "admin | manager | station"},
          "scope_type": {"type": "string", "description": "all | region | zone | station"},
          "scope_value": {"type": "string", "nullable": true, "description": "Region name, zone name, or station name, matching scope_type"},
          "display_name": {"type": "string", "nullable": true}
        },
        "required": ["email", "role", "scope_type"]
      },
      "OkResult": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "detail": {"type": "string", "nullable": true}
        },
        "required": ["ok"]
      },
      "StationMeta": {
        "type": "object",
        "properties": {
          "station_code": {"type": "string"},
          "station_name": {"type": "string"},
          "zone": {"type": "string"},
          "region": {"type": "string"}
        },
        "required": ["station_code", "station_name", "zone", "region"]
      },
      "RegionMeta": {
        "type": "object",
        "properties": {
          "region": {"type": "string"},
          "zones": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["region", "zones"]
      },
      "DrilldownResponse": {
        "type": "object",
        "properties": {
          "station_code": {"type": "string"},
          "station_name": {"type": "string"},
          "metric": {"type": "string"},
          "tracking_numbers": {"type": "array", "items": {"type": "string"}},
          "as_of": {"type": "string", "nullable": true, "format": "date-time", "description": "When the in-memory cache backing this was built (the last refresh); null if no refresh has run since restart"}
        },
        "required": ["station_code", "station_name", "metric", "tracking_numbers"]
      },
      "RefreshStatus": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "started_at": {"type": "string"},
          "finished_at": {"type": "string", "nullable": true},
          "status": {"type": "string", "description": "running | ok | error"},
          "stations_count": {"type": "integer", "nullable": true},
          "error_message": {"type": "string", "nullable": true},
          "triggered_by": {"type": "string", "nullable": true}
        },
        "required": ["id", "started_at", "finished_at", "status", "stations_count", "error_message", "triggered_by"]
      }
    }
  }
}
