# Custom environment variables & secrets for this app.
#
# Substrait reads this file when you upload the app and PRE-CREATES each entry under
# the app's Settings (Environment variables / Secrets), so after uploading you just
# fill in the real values in the portal — no redeploy needed for the values to apply.
#
# DO NOT list DATABASE_URL, JWT_SECRET, or the backing-service vars — the platform
# injects those.

# Your Redash instance's base URL (no trailing slash).
REDASH_BASE_URL=https://redash-my.ninjavan.co

# Your personal Redash API key (Redash -> profile/avatar -> Edit Profile -> API Key).
REDASH_API_KEY=   # secret

# Metabase (KPI Dashboard -> Hybrid Productivity, and the source for pasted data going forward).
METABASE_BASE_URL=https://metabase.ninjavan.co

# A Metabase API key (Admin -> Settings -> Authentication -> API keys) whose group can run questions 127194 (weekly), 127195 (monthly), 127196 (daily) and 127193 (driver list) -- the All-Regions copies.
METABASE_API_KEY=   # secret
